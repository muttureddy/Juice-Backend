# ========================================
# PROTEIN SPOT - Backend Environment Variables
# ========================================

# ── MongoDB Configuration ──
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/proteinspot?retryWrites=true&w=majority

# ── JWT Secret ──
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-random-string

# ── Twilio (for OTP) ──
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Razorpay Payment Gateway ──
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Zoho Email Configuration (SMTP) ──
# Your Zoho domain email settings
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_EMAIL_USER=orders@proteinspot.in
ZOHO_EMAIL_PASSWORD=your-zoho-email-password
EMAIL_FROM_NAME=Protein Spot
CONTACT_PHONE=+91 98765 43210

# ── Frontend URLs (for CORS) ──
FRONTEND_URL=https://proteinspot.in
FRONTEND_URL_LOCAL=http://localhost:3000
FRONTEND_URL_VERCEL=https://proteinspot.vercel.app

# ── Server Configuration ──
PORT=5000
NODE_ENV=development

# ========================================
# HOW TO GET ZOHO EMAIL CREDENTIALS:
# ========================================
# 1. Sign up at https://www.zoho.com/mail/
# 2. Add your domain email (orders@proteinspot.in)
# 3. Get SMTP settings from Zoho Mail Settings > Mail Accounts > SMTP
# 4. Use your domain email and password
# 5. Enable "Less Secure Apps" or use App Password for better security
# 
# SMTP Settings:
# - Host: smtp.zoho.com
# - Port: 465 (SSL) or 587 (TLS)
# - Secure: true for port 465, false for 587
# ========================================
