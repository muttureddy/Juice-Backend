# ─────────────────────────────────────────────────────
# Freshly Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017
DB_NAME=freshly_db

# JWT — change this to a long random string in production
JWT_SECRET=change_this_to_a_very_long_random_secret

# Twilio SMS (optional — omit in development for console OTP)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# Admin setup secret (used by POST /api/admin/setup)
ADMIN_SECRET_KEY=FRESHLY_ADMIN_2024

# Frontend URL for CORS (production)
# FRONTEND_URL=https://yourdomain.com
